{
  "name": "@tim/config",
  "version": "0.1.0",
  "description": "Shared frontend configuration: ESLint (config + custom rules), TypeScript and Prettier.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "src",
    "tsconfig"
  ],
  "exports": {
    "./eslint": {
      "types": "./src/eslint/index.d.ts",
      "default": "./src/eslint/index.js"
    },
    "./eslint-plugin": {
      "types": "./src/eslint-plugin/index.d.ts",
      "default": "./src/eslint-plugin/index.js"
    },
    "./prettier": {
      "types": "./src/prettier/index.d.ts",
      "default": "./src/prettier/index.js"
    },
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/react.json": "./tsconfig/react.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.js\" \"tests/rules/*.test.js\"",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.6.0",
    "typescript": ">=5.9.0 <6.1.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/estree": "^1.0.10",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "prettier": "^3.10.0",
    "typescript": "~6.0.3"
  }
}
